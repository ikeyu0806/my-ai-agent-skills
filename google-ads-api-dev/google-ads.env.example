# Copy to google-ads.env (gitignored) and fill in TEST-account values.
# Scripts auto-source ./google-ads.env or the skill dir's google-ads.env.
# Never commit real secrets.

export GADS_DEVELOPER_TOKEN="your-developer-token"   # test MCC's token (Test Access is fine)
export GADS_CLIENT_ID="xxxxx.apps.googleusercontent.com"
export GADS_CLIENT_SECRET="your-oauth-client-secret"
export GADS_REFRESH_TOKEN="your-oauth-refresh-token"
export GADS_LOGIN_CUSTOMER_ID="1234567890"           # TEST manager (MCC) id, digits only
export GADS_CUSTOMER_ID="9876543210"                 # TEST client account id, digits only
export GADS_API_VERSION="v23"                        # verify current major in release notes
